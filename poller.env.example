# MQTT — poller подключается к брокеру по сети хоста
MQTT_BROKER=tcp://localhost:1883
MQTT_USERNAME=arduino
MQTT_PASSWORD=change_me_mqtt
MQTT_BASE_TOPIC=home/arduino
MQTT_CLIENT_ID_POLLER=poller-01

# Устройство
DEVICE_ID=1
DEVICE_NAME=arduino-01

# Serial
SERIAL_PORT=COM5              # /dev/ttyUSB0 на Linux
SERIAL_BAUD=9600
POLL_INTERVAL=5s
